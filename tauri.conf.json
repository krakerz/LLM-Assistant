{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Assistant",
  "version": "1.11.0",
  "identifier": "llmassistant.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LLM Assistant",
        "width": 1100,
        "height": 760,
        "minWidth": 700,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "linux": {
      "deb": {
        "depends": ["bubblewrap"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
